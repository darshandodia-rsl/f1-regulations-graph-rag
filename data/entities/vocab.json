{
  "entity_types": {
    "OFFICIAL": "people or bodies that govern, run or police a Competition (FIA, stewards, Race Director, delegates, marshals, scrutineers)",
    "PARTICIPANT": "people or organisations that take part in or supply the Championship (drivers, Competitors, team personnel, Tyre Supplier, PU manufacturers, Commercial Rights Holder)",
    "EVENT": "a championship, competition, competition format, out-of-competition track activity (tests, PE, DE) or ceremony/media activity",
    "SESSION": "a track running session, a period within one (Q1, SQ2) or a defined lap type (formation lap, reconnaissance lap)",
    "PROCEDURE": "a regulated procedure, process or declared state (VSC, safety car period, suspension, parc fermé conditions, scrutineering, restricted period, low grip conditions)",
    "INFRINGEMENT": "a breach or offence the regulations penalise (unsafe release, pit lane speeding, false start, parc fermé breach)",
    "PENALTY": "a sanction the stewards or regulations may impose (drive-through, grid place penalty, reprimand, fine, disqualification)",
    "SIGNAL": "a flag, light, board, countdown signal or official message used to instruct drivers or Competitors",
    "LOCATION": "a physical area, line or place at the circuit (pit lane, fast lane, control line, grid, parc fermé)",
    "EQUIPMENT": "cars, car components and systems, tyres and other physical equipment (F1 car, safety car, power unit, overtake mode, tyre blankets)",
    "DOCUMENT": "a regulation, code, technical document, licence, form or official communication system (ISC, DMS, OMS, Super Licence, FIA-F1-DOC-079)"
  },
  "relation_types": {
    "MAY_IMPOSE": "an official may impose a penalty (OFFICIAL -> PENALTY)",
    "PUNISHABLE_BY": "an infringement is or may be penalised by a penalty (INFRINGEMENT -> PENALTY)",
    "CONTROLS": "has authority over, decides, orders, deploys or is responsible for something (OFFICIAL -> PROCEDURE | SESSION | EQUIPMENT | LOCATION | OFFICIAL)",
    "APPOINTS": "nominates or appoints an official or role (OFFICIAL | PARTICIPANT -> OFFICIAL | PARTICIPANT)",
    "REPORTS_TO": "reports to, consults or must stay in contact with another official (OFFICIAL -> OFFICIAL)",
    "SIGNALS": "a signal indicates, starts or ends a procedure or session (SIGNAL -> PROCEDURE | SESSION)",
    "OCCURS_AT": "a session, procedure, infringement or penalty takes place at, or equipment is kept at, a location (SESSION | PROCEDURE | INFRINGEMENT | PENALTY | EQUIPMENT -> LOCATION)",
    "APPLIES_DURING": "a rule, penalty, procedure or infringement applies in a given session, event or procedure (PENALTY | PROCEDURE | INFRINGEMENT | EQUIPMENT -> SESSION | EVENT | PROCEDURE)",
    "HAS_PART": "composition: the subject contains the object (EVENT -> SESSION, SESSION -> SESSION, LOCATION -> LOCATION, EQUIPMENT -> EQUIPMENT)",
    "TYPE_OF": "the subject is a kind or subtype of the object (any type -> same type, e.g. sprint qualifying -> lap time classified session, mule car -> f1 car)",
    "PRECEDES": "the subject happens before the object in the competition timeline (SESSION | PROCEDURE | EVENT -> SESSION | PROCEDURE | EVENT)",
    "DETERMINES": "the result or outcome of the subject sets the object, e.g. a grid or classification (SESSION | PROCEDURE -> SESSION | PROCEDURE)",
    "REQUIRES": "the subject must use, wear, hold, comply with or submit the object (PARTICIPANT | EQUIPMENT | SESSION | PROCEDURE | EVENT -> EQUIPMENT | DOCUMENT | PROCEDURE)",
    "ALLOCATES": "provides, supplies or allocates the object to participants (OFFICIAL | PARTICIPANT -> EQUIPMENT | LOCATION)",
    "DEFINED_IN": "the subject is defined, detailed or governed by a document (any type -> DOCUMENT)"
  },
